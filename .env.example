APP_NAME="API Recouvrement"
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://recouvrement_user:recouvrement_password@localhost:5432/recouvrement_db

CORS_ORIGINS=["http://localhost:4200"]

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optionnel : si definis, un compte SUPER_ADMIN est cree automatiquement au demarrage
# (uniquement si aucun compte n'existe deja pour cet email). A retirer/changer en production.
SUPER_ADMIN_EMAIL=super@platform.com
SUPER_ADMIN_PASSWORD=changeme123
